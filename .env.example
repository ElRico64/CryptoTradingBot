# Copy to .env (never commit it). Only what you use is needed; paper mode needs nothing.

# --- Solana -----------------------------------------------------------------
# Use a DEDICATED hot wallet holding only what you are willing to lose.
# Base58 string (Phantom/Axiom export) or the JSON array from solana-keygen.
SOLANA_PRIVATE_KEY=
# A paid RPC (Helius, Triton, QuickNode...) is strongly recommended for speed and reliability.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
JUPITER_API_KEY=

# --- EVM (Base / BSC / Ethereum) ---------------------------------------------
EVM_PRIVATE_KEY=
EVM_RPC_URL_BASE=
EVM_RPC_URL_BSC=
EVM_RPC_URL_ETHEREUM=
ZEROX_API_KEY=

# --- Narrative feeds -----------------------------------------------------------
X_BEARER_TOKEN=
ANTHROPIC_API_KEY=

# --- Alerts ------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Required, in addition to `mode: live`, before any real trade is placed.
MEMEBOT_I_ACCEPT_THE_RISK=no
